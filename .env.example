NODE_ENV=development
GATHER_DATABASE_MODE=native
PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://gather_runtime:gather_local_development@127.0.0.1:54329/gather
MIGRATION_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/gather
TEST_MIGRATION_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/gather_test
RUNTIME_DATABASE_PASSWORD=gather_local_development
DATABASE_POOL_MAX=12
OIDC_ISSUER=http://127.0.0.1:4010
# Optional metadata URL when the provider's customer hostname differs from its signed issuer.
# OIDC_DISCOVERY_URL=https://<tenant-name>.ciamlogin.com/<tenant-id>/v2.0/.well-known/openid-configuration
OIDC_CLIENT_ID=gather-local
OIDC_CALLBACK_URL=http://127.0.0.1:3000/api/v1/auth/callback
# Production: separate Entra External ID member (email OTP) and contributor (MFA) web registrations.
# OIDC_CLIENT_ID and OIDC_CLIENT_SECRET belong to the member registration.
# OIDC_CONTRIBUTOR_CLIENT_ID=
# OIDC_CONTRIBUTOR_CLIENT_SECRET=
# OIDC_SUBJECT_MODE=entra-oid
# OIDC_TENANT_ID=
EXTERNAL_SERVICES_ENABLED=false
# 32+ random characters, stored as an Azure secret in production; needed for anonymous reactions and rate limiting.
PUBLIC_VISITOR_SECRET=replace-with-a-random-secret-at-least-32-characters
TWILIO_SENDER_NAME=
STUDY_COWRITER_ENABLED=false
STUDY_COWRITER_ONLY=true
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna

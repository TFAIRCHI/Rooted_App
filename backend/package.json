{
  "name": "@gather/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/workers/worker.ts",
    "auth:dev": "tsx src/auth/local-issuer.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/workers/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/integrations/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:migrate": "tsx src/infrastructure/migrate.ts",
    "db:seed": "tsx src/infrastructure/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "luxon": "3.7.2",
    "oidc-provider": "9.12.2",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/luxon": "3.7.6",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

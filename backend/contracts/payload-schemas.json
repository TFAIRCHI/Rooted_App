{
  "PlanPayload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "number",
        "const": 1
      },
      "title": {
        "type": "string",
        "maxLength": 500
      },
      "primaryScripture": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "maxLength": 500
          },
          "translation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reference",
          "translation"
        ],
        "additionalProperties": false
      },
      "learningObjective": {
        "type": "string",
        "maxLength": 10000
      },
      "outline": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "discussionQuestion": {
        "type": "string",
        "maxLength": 10000
      },
      "notes": {
        "type": "string",
        "maxLength": 50000
      },
      "extensions": {
        "maxItems": 50,
        "type": "array",
        "items": {}
      }
    },
    "required": [
      "schemaVersion",
      "title",
      "primaryScripture",
      "learningObjective",
      "outline",
      "discussionQuestion",
      "notes",
      "extensions"
    ],
    "additionalProperties": false
  },
  "ContentPayload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "number",
        "const": 1
      },
      "title": {
        "type": "string",
        "maxLength": 500
      },
      "body": {
        "type": "string",
        "maxLength": 100000
      },
      "reflection": {
        "type": "string",
        "maxLength": 20000
      },
      "discussionQuestion": {
        "type": "string",
        "maxLength": 10000
      },
      "application": {
        "type": "string",
        "maxLength": 20000
      },
      "references": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "outboundPreview": {
        "type": "string",
        "maxLength": 2000
      },
      "scriptureReading": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "maxLength": 100
          },
          "translation": {
            "type": "string",
            "const": "KJV"
          },
          "edition": {
            "type": "string",
            "const": "1769"
          },
          "source": {
            "type": "string",
            "maxLength": 100
          },
          "digest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "verses": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "number",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "featuredVerse": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "reference",
          "translation",
          "edition",
          "source",
          "digest",
          "verses",
          "featuredVerse"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "schemaVersion",
      "title",
      "body",
      "reflection",
      "discussionQuestion",
      "application",
      "references",
      "outboundPreview"
    ],
    "additionalProperties": false
  }
}
